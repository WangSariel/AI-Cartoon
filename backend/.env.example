# DeepSeek API
# Optional. Users can enter this in the web UI instead.
# Backend env value is only used as a fallback when the frontend key is empty.
DEEPSEEK_API_KEY=

# Image API
# Optional. Users can enter this in the web UI instead.
# Backend env value is only used as a fallback when the frontend key is empty.
IMAGE_API_KEY=
# AIHubMix OpenAI-compatible endpoint.
IMAGE_API_BASE_URL=https://aihubmix.com/v1
# Optional fallback. Only use a proxy/provider that supports /v1/images/generations and /v1/images/edits.
# Example: IMAGE_API_BASE_URL_FALLBACK=https://your-openai-compatible-proxy.example/v1
IMAGE_API_BASE_URL_FALLBACK=
# OpenAI image model. If your proxy explicitly provides gpt-image-2, you can set IMAGE_MODEL=gpt-image-2.
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_MAX_RETRIES=6
IMAGE_RETRY_BASE_SECONDS=1
IMAGE_RETRY_MAX_SECONDS=30
IMAGE_RETRY_JITTER_SECONDS=2
IMAGE_REQUEST_TIMEOUT_SECONDS=300
IMAGE_CONNECT_TIMEOUT_SECONDS=30
IMAGE_READ_TIMEOUT_SECONDS=300
IMAGE_WRITE_TIMEOUT_SECONDS=120
IMAGE_POOL_TIMEOUT_SECONDS=30
IMAGE_MAX_CONNECTIONS=20
IMAGE_MAX_KEEPALIVE_CONNECTIONS=8
IMAGE_PRIMARY_FAILURES_BEFORE_FALLBACK=2

# Database
# Local SQLite is the default and needs no external service.
DATABASE_URL=sqlite:///./manga.db
# Optional PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manga_novel
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ZIP_BYTES=524288000
MAX_IMPORT_ZIP_FILES=500
MAX_IMPORT_ZIP_FILE_BYTES=10485760
MAX_IMPORT_ZIP_RATIO=100
MAX_CHARACTER_PROFILE_CHARS=20000
MAX_IMPORTED_NOVEL_CHARS=50000
MAX_REF_IMAGES_PER_LEVEL=4
MAX_MANGA_GENERATION_JOBS=3
SSE_QUEUE_SIZE=300
JOB_EVENT_HISTORY_LIMIT=300
# Optional. If set, frontend must set matching VITE_API_TOKEN.
API_TOKEN=
# Optional alternative to API_TOKEN. Comma-separated multiple tokens.
API_TOKENS=
# When no token is configured, non-local /api requests are rejected by default.
REQUIRE_API_TOKEN_FOR_REMOTE=true
